    {
    "type": "function",
    "function": {
        "name": "call_subagent",
        "description": "Delegates a task to a specialized subagent.",
        "parameters": {
            "type": "object",
            "properties": {
                "subagent_name": {
                    "type": "string",
                    "oneOf": [
                        {
                            "const": "desktop_copilot",
                            "description": "Controls desktop applications, performs UI actions, clicks, and types."
                        }
                        ]
                    },
                "task_description": {"type": "string","description": "Clear instructions specifying what the subagent should execute."}
            },
            "required": ["subagent_name", "task_description"]
            }
        }
    }
]